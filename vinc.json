{
	"template": "<YEAR>.<MONTH>.<COUNTER>",
	"version": "2026.3.4",
	"YEAR": 2026,
	"MONTH": 3,
	"COUNTER": 4,
	"targets": {
		"pyproject.toml": {
			"find": "\"<VERSION>\"\\s*#\\s*version",
			"replace": "\"<VERSION>\" # version"
		},
		"simple_oop/__init__.py": {
			"find": "version\\s*=\\s*\"<VERSION>\"",
			"replace": "version=\"<VERSION>\""
		}
	}
}